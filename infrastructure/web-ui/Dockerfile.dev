# Development image: runs the web-ui with air hot-reload so the server is
# automatically rebuilt and restarted whenever source files change.
# The source tree is bind-mounted from the host via docker-compose.override.yml.
FROM golang:alpine

RUN go install github.com/air-verse/air@latest

WORKDIR /app

COPY go.mod ./
COPY main.go ./
COPY public/ ./public/

EXPOSE 3000

CMD ["air", "-c", ".air.toml"]
