PAYMENT_SERVICE_PORT=8086
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payment_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AUTH_SERVICE_URL=http://localhost:8085
INTERNAL_SERVICE_TOKEN=default_internal_service_token

# Must match RS256 public key corresponding to AUTH_JWT_PRIVATE_KEY_PEM in auth-service
# Step 1: openssl genrsa -out private.pem 2048
# Step 2: openssl rsa -in private.pem -pubout -out public.pem
# Step 3: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' public.pem
AUTH_JWT_PUBLIC_KEY_PEM=

PAYMENT_ENCRYPTION_KEY=default_32_bytes_payment_enc_key
