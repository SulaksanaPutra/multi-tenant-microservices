DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
PORT=8085

# RSA-2048 private key in PEM format (single-line with \n escapes)
# Generate with: openssl genrsa -out private.pem 2048
# Then: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
AUTH_JWT_PRIVATE_KEY_PEM=

# Internal cross-service authentication + workspace enrichment target
INTERNAL_SERVICE_TOKEN=default_internal_service_token
TENANT_SERVICE_URL=http://tenant-service:8082
