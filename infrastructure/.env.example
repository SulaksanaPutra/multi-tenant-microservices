# Shared Infrastructure Environment Variables

# Deployment tier (lite | standard | premium) — read by scripts/up.sh and scripts/down.sh.
# Switching tiers requires a fresh state (scripts/down.sh -v) since no live
# tier-to-tier migration is supported.
TIER=standard

# PostgreSQL Core Database Container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shared_db
POSTGRES_PORT=5432

# RabbitMQ Event Broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Mailpit Mock SMTP Server
MAILPIT_SMTP_PORT=1025
MAILPIT_DASHBOARD_PORT=8025

# Traefik API Gateway
TRAEFIK_HTTP_PORT=8000
TRAEFIK_DASHBOARD_PORT=8080
