# Shared Infrastructure Environment Variables (broker/)

# PostgreSQL Shared Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=broker_db
POSTGRES_PORT=5432

# PostgreSQL Dedicated Database
POSTGRES_DEDICATED_DB=broker_dedicated_db
POSTGRES_DEDICATED_PORT=5433

# RabbitMQ Event Broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Mailpit Mock SMTP Server
MAILPIT_SMTP_PORT=1025
MAILPIT_DASHBOARD_PORT=8025

# Traefik API Gateway
TRAEFIK_HTTP_PORT=8000
TRAEFIK_DASHBOARD_PORT=8080
