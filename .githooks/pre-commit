#!/usr/bin/env bash
# .githooks/pre-commit — Local pre-commit hook enforcing Go AST standards, OpenAPI spec sync & unit tests.
set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "==> Running Local Pre-Commit Checks..."

# Step 1: Run Go AST Coding Standards Checker
echo "--> 1/3: Auditing Clean Architecture & Coding Standards..."
if ! (cd "$ROOT/tools/standards-checker" && go run .); then
  echo ""
  echo "❌ Commit aborted: Code standards scan failed. Please fix the violations above before committing." >&2
  exit 1
fi

# Step 2: Run Go AST OpenAPI Spec Generator & Auto-Stage Docs
echo "--> 2/3: Regenerating OpenAPI Specifications..."
if ! (cd "$ROOT/tools/openapi-generator" && go run .); then
  echo ""
  echo "❌ Commit aborted: OpenAPI spec generation failed." >&2
  exit 1
fi

# Auto-stage regenerated OpenAPI specs if modified
if [ -d "$ROOT/docs/openapi" ]; then
  git add "$ROOT/docs/openapi"
fi

# Step 3: Run Unit Tests Across All Services
echo "--> 3/3: Running Unit Tests Across All Microservices..."
TEST_SERVICES=(auth-service tenant-service user-service order-service notification-service infra-provisioner payment-service)
for svc in "${TEST_SERVICES[@]}"; do
  if ! (cd "$ROOT/$svc" && CGO_ENABLED=0 go test ./...); then
    echo ""
    echo "❌ Commit aborted: Unit tests failed in '$svc'." >&2
    exit 1
  fi
done

echo "==> All pre-commit checks passed cleanly!"
